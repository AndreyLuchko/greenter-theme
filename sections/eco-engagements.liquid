{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<div
  class="
    section
    section--{{ section.settings.section_width }}
    {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
    spacing-style
    eco-engagements
  "
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {%- if section.settings.heading != blank -%}
    <h2 class="eco-engagements__heading h3">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <ul class="eco-engagements__list" role="list">
      {%- for block in section.blocks -%}
        <li class="eco-engagements__item" {{ block.shopify_attributes }}>
          {%- render 'icon-or-image',
            icon: block.settings.icon,
            image_upload: block.settings.image_upload,
            width: 40,
            class_name: 'eco-engagements__icon'
          -%}

          {%- if block.settings.heading != blank -%}
            <h3 class="eco-engagements__title h5">
              {%- if block.settings.link != blank -%}
                <a class="eco-engagements__link" href="{{ block.settings.link }}">
                  {{- block.settings.heading | escape -}}
                </a>
              {%- else -%}
                {{- block.settings.heading | escape -}}
              {%- endif -%}
            </h3>
          {%- endif -%}

          {%- if block.settings.text != blank -%}
            <div class="eco-engagements__text rte">{{ block.settings.text }}</div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{% stylesheet %}
  .eco-engagements__heading {
    margin: 0 0 var(--gap-lg);
    text-align: center;
  }

  .eco-engagements__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap-lg) var(--gap-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .eco-engagements__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-sm);
    text-align: center;
    overflow-wrap: anywhere;
  }

  .eco-engagements__icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    object-fit: contain;
    color: var(--color-foreground);
  }

  .eco-engagements__title {
    margin: 0;
  }

  .eco-engagements__link {
    color: inherit;
    text-decoration: none;
  }

  .eco-engagements__link:hover {
    text-decoration: underline;
  }

  .eco-engagements__text {
    color: var(--color-foreground-muted, var(--color-foreground));
  }

  .eco-engagements__text > :first-child {
    margin-top: 0;
  }

  .eco-engagements__text > :last-child {
    margin-bottom: 0;
  }

  @media screen and (min-width: 990px) {
    .eco-engagements__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--gap-xl, var(--gap-lg));
    }
  }
{% endstylesheet %}

