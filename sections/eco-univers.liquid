{% liquid
  assign filled_blocks = 0
  for block in section.blocks
    if block.settings.collection != blank
      assign filled_blocks = filled_blocks | plus: 1
    endif
  endfor

  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

{%- if filled_blocks > 0 or request.design_mode -%}
  <div
    class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  ></div>

  <div
    class="
      section
      section--{{ section.settings.section_width }}
      {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
      spacing-style
    "
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <div class="eco-univers">
      {%- if section.settings.heading != blank -%}
        <h2 class="eco-univers__heading h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <ul class="eco-univers__grid" role="list">
        {%- for block in section.blocks -%}
          {%- assign univers_collection = block.settings.collection -%}

          {%- if univers_collection != blank -%}
            {%- comment -%}
              Block image wins; otherwise collection.featured_image
              (collection image, then the first product's image).
            {%- endcomment -%}
            {%- assign card_image = block.settings.image | default: univers_collection.featured_image -%}

            <li class="eco-univers__item" {{ block.shopify_attributes }}>
              <a class="eco-univers__card" href="{{ univers_collection.url }}">
                <div class="eco-univers__media">
                  {%- if card_image != blank -%}
                    {{
                      card_image
                      | image_url: width: 720
                      | image_tag:
                        class: 'eco-univers__image',
                        widths: '240, 360, 480, 720',
                        sizes: '(min-width: 750px) 30vw, 45vw',
                        loading: 'lazy',
                        alt: card_image.alt
                    }}
                  {%- else -%}
                    {{ 'collection-1' | placeholder_svg_tag: 'eco-univers__image eco-univers__image--placeholder' }}
                  {%- endif -%}
                </div>
                <h3 class="eco-univers__title h5">{{ univers_collection.title | escape }}</h3>
                <p class="eco-univers__count">
                  {{- 'content.search_results_resource_products_count' | t: count: univers_collection.all_products_count -}}
                </p>
              </a>
            </li>
          {%- elsif request.design_mode -%}
            <li class="eco-univers__item" {{ block.shopify_attributes }}>
              <div class="eco-univers__card">
                <div class="eco-univers__media">
                  {%- assign placeholder_name = 'collection-' | append: forloop.index -%}
                  {{ placeholder_name | placeholder_svg_tag: 'eco-univers__image eco-univers__image--placeholder' }}
                </div>
                <p class="eco-univers__count">{{ 'sections.eco_univers.empty' | t }}</p>
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .eco-univers {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xl, var(--gap-lg));
  }

  .eco-univers__heading {
    margin: 0;
  }

  .eco-univers__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .eco-univers__item {
    min-width: 0;
  }

  .eco-univers__card {
    display: flex;
    flex-direction: column;
    gap: var(--padding-xs, 8px);
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .eco-univers__media {
    overflow: hidden;
    border-radius: var(--style-border-radius-lg, 0);
  }

  .eco-univers__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    transition: transform var(--animation-speed-medium, 0.3s) ease;
  }

  .eco-univers__image--placeholder {
    background-color: rgb(var(--color-foreground-rgb) / 0.04);
  }

  .eco-univers__title {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .eco-univers__count {
    margin: 0;
    font-size: var(--font-size--body-sm, 0.875rem);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text, 0.7));
  }

  .eco-univers__card:is(:hover, :focus-visible) .eco-univers__title {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  @media (prefers-reduced-motion: no-preference) {
    a.eco-univers__card:hover .eco-univers__image {
      transform: scale(1.03);
    }
  }

  @media screen and (min-width: 750px) {
    .eco-univers__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.eco_univers",
  "tag": "section",
  "class": "section-wrapper",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.eco_univers_heading"
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "univers",
      "name": "t:names.eco_univers_item",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:settings.collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:settings.image",
          "info": "t:info.eco_univers_image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.eco_univers",
      "category": "t:categories.collection",
      "blocks": [
        { "type": "univers" },
        { "type": "univers" },
        { "type": "univers" },
        { "type": "univers" },
        { "type": "univers" },
        { "type": "univers" }
      ]
    }
  ]
}
{% endschema %}
