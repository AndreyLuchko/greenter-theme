{% liquid
  assign mif_collection = section.settings.collection
  assign products_limit = section.settings.products_to_show

  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

{%- if mif_collection != blank or request.design_mode -%}
  <div
    class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  ></div>

  <div
    class="
      section
      section--{{ section.settings.section_width }}
      {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
      spacing-style
    "
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <div class="eco-mif">
      {%- if section.settings.image != blank -%}
        <div class="eco-mif__media">
          {{
            section.settings.image
            | image_url: width: 1100
            | image_tag:
              class: 'eco-mif__image',
              widths: '375, 550, 750, 1100',
              sizes: '(min-width: 990px) 40vw, 100vw',
              loading: 'lazy',
              alt: section.settings.image.alt
          }}
        </div>
      {%- elsif request.design_mode -%}
        <div class="eco-mif__media">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'eco-mif__image eco-mif__image--placeholder' }}
        </div>
      {%- endif -%}

      <div class="eco-mif__content">
        {%- if section.settings.subheading != blank -%}
          <p class="eco-mif__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="eco-mif__heading h2">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="eco-mif__text rte">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="eco-mif__badges" role="list">
            {%- for block in section.blocks -%}
              {%- if block.settings.text != blank or request.design_mode -%}
                <li class="eco-mif__badge" {{ block.shopify_attributes }}>
                  {%- if block.settings.icon != 'none' -%}
                    <svg
                      class="eco-mif__badge-icon icon-default"
                      aria-hidden="true"
                      focusable="false"
                      xmlns="http://www.w3.org/2000/svg"
                      width="20"
                      height="20"
                      viewBox="0 0 20 20"
                    >
                      {%- render 'icon', icon: block.settings.icon -%}
                    </svg>
                  {%- endif -%}
                  <span>{{ block.settings.text | escape }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if mif_collection != blank -%}
          <a class="button eco-mif__button" href="{{ mif_collection.url }}">
            {{-
              'sections.eco_made_in_france.button_count'
              | t: label: section.settings.button_label, count: mif_collection.products_count
            -}}
          </a>
        {%- else -%}
          <p class="eco-mif__empty">{{ 'sections.eco_made_in_france.empty' | t }}</p>
        {%- endif -%}
      </div>

      {%- if mif_collection != blank -%}
        {%- capture product_items -%}
          {%- assign shown = 0 -%}
          {%- for product in mif_collection.products -%}
            {%- if product.available -%}
              <li class="eco-mif__product">
                {%- render 'resource-card',
                  resource: product,
                  resource_type: 'product',
                  image_aspect_ratio: '1',
                  image_sizes: '(min-width: 990px) 25vw, 50vw'
                -%}
              </li>
              {%- assign shown = shown | plus: 1 -%}
              {%- if shown >= products_limit -%}{%- break -%}{%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}

        {%- if shown > 0 -%}
          <ul
            class="eco-mif__products"
            role="list"
            aria-label="{{ 'sections.eco_made_in_france.products_heading' | t: collection: mif_collection.title | escape }}"
          >
            {{ product_items }}
          </ul>
        {%- endif -%}
      {%- else -%}
        <ul class="eco-mif__products" role="list">
          {%- for i in (1..products_limit) -%}
            <li class="eco-mif__product">
              {{ 'product-1' | placeholder_svg_tag: 'eco-mif__placeholder' }}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .eco-mif {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'media'
      'content'
      'products';
    gap: var(--gap-xl, var(--gap-lg));
    align-items: start;
  }

  .eco-mif__media {
    grid-area: media;
    overflow: hidden;
    border-radius: var(--style-border-radius-lg, 0);
  }

  .eco-mif__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .eco-mif__image--placeholder {
    background-color: rgb(var(--color-foreground-rgb) / 0.04);
  }

  .eco-mif__content {
    grid-area: content;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap-md);
  }

  .eco-mif__subheading {
    margin: 0;
    font-size: var(--font-size--sm, 0.875rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .eco-mif__heading,
  .eco-mif__text > :first-child {
    margin: 0;
  }

  .eco-mif__text > :last-child {
    margin-bottom: 0;
  }

  .eco-mif__badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .eco-mif__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-2xs, 4px);
    padding: 6px 12px;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.2);
    border-radius: 999px;
    font-size: var(--font-size--sm, 0.875rem);
  }

  .eco-mif__badge-icon {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
  }

  .eco-mif__empty {
    margin: 0;
    font-style: italic;
  }

  .eco-mif__products {
    grid-area: products;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .eco-mif__product {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .eco-mif__placeholder {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    background-color: rgb(var(--color-foreground-rgb) / 0.04);
  }

  @media screen and (min-width: 990px) {
    .eco-mif {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
      grid-template-areas:
        'media products'
        'content products';
    }
  }
{% endstylesheet %}

